# Database Configuration
# SQLite (default - no setup required, great for development)
DATABASE_URL=sqlite:///./crewlayover.db

# PostgreSQL (uncomment and configure if using PostgreSQL)
# DATABASE_URL=postgresql://crewlayover:crewlayover@localhost:5432/crewlayover

# Security
SECRET_KEY=your-secret-key-change-this-in-production-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# External APIs
# Get your free API key from: https://openweathermap.org/api
WEATHER_API_KEY=

# Redis (optional - for caching)
# REDIS_URL=redis://localhost:6379

# Environment
ENVIRONMENT=development
